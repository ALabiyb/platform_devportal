# ---------------------------------------------------------------------------
# Author: Labiyb M. Said — DevSecOps Engineer
# Contact: saidlabiybm@gmail.com
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in every value.
# NEVER commit .env — it is listed in .gitignore.
#
# There are NO hardcoded domain defaults in devportal.
# Every URL must be set explicitly so the same binary works on any infrastructure
# without code changes — just swap the .env or K8s Secret values.

# ── HTTP Server ──────────────────────────────────────────────────────────────
HTTP_ADDR=:8080

# ── DevPortal Database (devportal's own PostgreSQL) ──────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devportal
DB_USER=devportal
DB_PASSWORD=                          # REQUIRED
DB_SSL_MODE=disable                   # use "require" in production

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_MODE=oidc                        # "oidc" (Keycloak) | "gitlab" (OAuth fallback)

# ── Organisation (single org in v0.1) ────────────────────────────────────────
ORG_NAME=NexBridge Technologies       # displayed in the UI
ORG_SLUG=nexbridge                    # used in DB + API paths (URL-safe, lowercase)

ADMIN_EMAIL=                          # bootstrap admin email — remove after Keycloak groups are set up

# ── OIDC / Keycloak (used when AUTH_MODE=oidc) ───────────────────────────────
OIDC_ISSUER_URL=                      # REQUIRED  e.g. https://keycloak.example.com/realms/myorg
OIDC_CLIENT_ID=devportal
OIDC_CLIENT_SECRET=                   # REQUIRED
OIDC_REDIRECT_URL=                    # REQUIRED  e.g. https://devportal.example.com/auth/callback
OIDC_ADMIN_GROUP=devportal-admins
OIDC_DEVELOPER_GROUP=devportal-developers

# ── GitLab / Gitea (API calls + OAuth fallback) ───────────────────────────────
GITLAB_URL=                           # REQUIRED  e.g. https://gitlab.example.com
GITLAB_TOKEN=                         # REQUIRED  PAT with scope: api
GITLAB_OAUTH_CLIENT_ID=               # REQUIRED when AUTH_MODE=gitlab
GITLAB_OAUTH_CLIENT_SECRET=           # REQUIRED when AUTH_MODE=gitlab
GITLAB_OAUTH_REDIRECT_URL=            # REQUIRED when AUTH_MODE=gitlab  e.g. https://devportal.example.com/auth/callback

# ── Jenkins ──────────────────────────────────────────────────────────────────
JENKINS_URL=                          # REQUIRED  internal URL e.g. http://jenkins:8080
JENKINS_PUBLIC_URL=                   # REQUIRED  public URL reachable by browser + GitLab webhooks
JENKINS_USER=admin
JENKINS_TOKEN=                        # REQUIRED  Jenkins API token

# ── Harbor ───────────────────────────────────────────────────────────────────
HARBOR_URL=                           # REQUIRED  e.g. https://harbor.example.com
HARBOR_USER=admin
HARBOR_TOKEN=                         # REQUIRED  Harbor admin password or robot account secret

# ── DefectDojo ───────────────────────────────────────────────────────────────
DEFECTDOJO_URL=                       # REQUIRED  e.g. https://defectdojo.example.com
DEFECTDOJO_TOKEN=                     # REQUIRED  DefectDojo API token

# ── ArgoCD ───────────────────────────────────────────────────────────────────
ARGOCD_URL=                           # REQUIRED  e.g. https://argocd.example.com
ARGOCD_TOKEN=                         # REQUIRED  argocd account generate-token
ARGOCD_INSECURE=false                 # set true if ArgoCD uses a self-signed cert

# ── App PostgreSQL (provisioned for developer apps, NOT devportal's own DB) ──
APP_DB_HOST=                          # REQUIRED  e.g. postgres.namespace.svc.cluster.local
APP_DB_PORT=5432
APP_DB_ADMIN_USER=postgres
APP_DB_ADMIN_PASSWORD=                # REQUIRED  postgres superuser password

# ── Credential Encryption ────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=                       # REQUIRED  32-byte AES-256-GCM key, base64-encoded

# ── Jenkinsfile / K8s Manifest values ────────────────────────────────────────
# These are written into every generated Jenkinsfile and K8s manifest.
# Change here once — all future projects pick up the new value automatically.
REGISTRY_URL=                         # REQUIRED  hostname only, no https://  e.g. harbor.example.com
REGISTRY_CREDENTIALS_ID=robot-jenkins # Jenkins credential ID for Harbor push
GIT_CREDENTIALS_ID=                   # REQUIRED  Jenkins credential ID for Git clone
SHARED_LIBRARY_URL=                   # REQUIRED  Git URL of Jenkins shared pipeline library
DEPENDENCY_TRACK_URL=                 # REQUIRED  e.g. https://dependencytrack.example.com
K8S_MANIFEST_GROUP=kubernetes-manifest
INGRESS_BASE_DOMAIN=                  # REQUIRED  base domain for app ingress e.g. apps.example.com

# ── Git Bot Commit Author ─────────────────────────────────────────────────────
BOT_NAME=DevPortal Bot
BOT_EMAIL=                            # REQUIRED  e.g. devportal@example.com

# ── TLS ──────────────────────────────────────────────────────────────────────
# Skips certificate validation for outbound calls to Jenkins, Harbor, ArgoCD, etc.
# Set to "false" once proper certs are installed on all downstream services.
TLS_SKIP_VERIFY=true
