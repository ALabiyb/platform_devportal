# ---------------------------------------------------------------------------
# Author: Labiyb M. Said — DevSecOps Engineer
# Contact: saidlabiybm@gmail.com
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in every value marked REQUIRED.
# NEVER commit .env — it is listed in .gitignore.
# Generate: cp .env.example .env

# ── HTTP Server ──────────────────────────────────────────────────────────────
HTTP_ADDR=:8080

# ── DevPortal Database (devportal's own PostgreSQL) ──────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devportal
DB_USER=devportal
DB_PASSWORD=changeme                          # REQUIRED — set a strong password
DB_SSL_MODE=disable                           # use "require" in production

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_MODE=oidc                                # "oidc" (Keycloak) | "gitlab" (OAuth fallback)
ADMIN_EMAIL=saidlabiybm@gmail.com        # bootstrap admin — remove after Keycloak groups are set up

# ── OIDC / Keycloak (used when AUTH_MODE=oidc) ───────────────────────────────
OIDC_ISSUER_URL=https://keycloak.devops.softnethq.co.tz/realms/softnet
OIDC_CLIENT_ID=devportal
OIDC_CLIENT_SECRET=                           # REQUIRED when AUTH_MODE=oidc
OIDC_REDIRECT_URL=https://devportal.devops.softnethq.co.tz/auth/callback
OIDC_ADMIN_GROUP=devportal-admins
OIDC_DEVELOPER_GROUP=devportal-developers

# ── GitLab (API calls + OAuth fallback) ──────────────────────────────────────
GITLAB_URL=http://192.168.15.85
GITLAB_TOKEN=                                 # REQUIRED — GitLab PAT, scope: api
GITLAB_OAUTH_CLIENT_ID=                       # required when AUTH_MODE=gitlab
GITLAB_OAUTH_CLIENT_SECRET=                   # required when AUTH_MODE=gitlab
GITLAB_OAUTH_REDIRECT_URL=https://devportal.devops.softnethq.co.tz/auth/callback

# ── Jenkins ──────────────────────────────────────────────────────────────────
JENKINS_URL=http://192.168.200.78:8080
JENKINS_PUBLIC_URL=https://jenkins.devops.softnethq.co.tz
JENKINS_USER=admin
JENKINS_TOKEN=                                # REQUIRED — Jenkins API token

# ── Harbor ───────────────────────────────────────────────────────────────────
HARBOR_URL=https://harbor.devops.softnethq.co.tz
HARBOR_USER=admin
HARBOR_TOKEN=                                 # REQUIRED — Harbor admin password or robot account secret

# ── DefectDojo ───────────────────────────────────────────────────────────────
DEFECTDOJO_URL=https://defectdojo.devops.softnethq.co.tz
DEFECTDOJO_TOKEN=                             # REQUIRED — DefectDojo API token

# ── ArgoCD ───────────────────────────────────────────────────────────────────
ARGOCD_URL=https://argocd.devops.softnethq.co.tz
ARGOCD_TOKEN=                                 # REQUIRED — generate: argocd account generate-token
ARGOCD_INSECURE=false                         # set true if ArgoCD uses a self-signed cert

# ── App PostgreSQL (provisioned for developer apps, NOT devportal's own DB) ──
APP_DB_HOST=postgres.devops.svc.cluster.local
APP_DB_PORT=5432
APP_DB_ADMIN_USER=postgres
APP_DB_ADMIN_PASSWORD=                        # REQUIRED — postgres superuser password

# ── Credential Encryption ────────────────────────────────────────────────────
# AES-256-GCM key stored in a K8s Secret and mounted as an env var.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=                               # REQUIRED — 32-byte key, base64-encoded

# ── Jenkinsfile / K8s Manifest defaults ──────────────────────────────────────
REGISTRY_URL=harbor.devops.softnethq.co.tz
REGISTRY_CREDENTIALS_ID=robot-jenkins
GIT_CREDENTIALS_ID=lsaid
SHARED_LIBRARY_URL=http://192.168.15.85/devsecops1/pipeline.git
DEPENDENCY_TRACK_URL=https://dependencytrack.devops.softnethq.co.tz
K8S_MANIFEST_GROUP=kubernetes-manifest
INGRESS_BASE_DOMAIN=k8s.softnethq.co.tz

# ── Git bot commit author ─────────────────────────────────────────────────────
BOT_NAME=DevPortal Bot
BOT_EMAIL=devportal@softnet.co.tz

# ── TLS ──────────────────────────────────────────────────────────────────────
# Skips certificate validation for outbound calls to GitLab, Jenkins, Harbor, etc.
# Acceptable on the internal LAN with self-signed certs.
# Set to "false" once proper certs are installed on all downstream services.
TLS_SKIP_VERIFY=true
