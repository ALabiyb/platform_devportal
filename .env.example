# Author: Labiyb M. Said — DevSecOps Engineer
# Contact: saidlabiybm@gmail.com
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values you need.
# NEVER commit .env — it is listed in .gitignore.
#
# Only two variables are REQUIRED to start the app:
#   DB_PASSWORD    — devportal's own PostgreSQL password
#   ENCRYPTION_KEY — AES-256 key for credential storage
#
# All integration vars (Gitea, Jenkins, Harbor, etc.) are optional at startup.
# Leave them empty during development — the app and UI work fully without them.
# Errors only appear when you trigger a provisioning run that needs a missing var.

# ── HTTP Server ──────────────────────────────────────────────────────────────
HTTP_ADDR=:8080

# ── DevPortal Database (devportal's own PostgreSQL) ──────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devportal
DB_USER=devportal
DB_PASSWORD=                          # REQUIRED
DB_SSL_MODE=disable                   # use "require" in production

# ── Auth Mode ────────────────────────────────────────────────────────────────
# "local" — built-in username + password, devportal manages accounts.
#            No external IdP needed. Perfect for personal lab and demos.
#            Bootstrap: POST /auth/register creates the first admin account.
#
# "oidc"  — Keycloak / Authentik / Dex. Recommended for production.
#            Supports SSO, AD/LDAP federation, and group-based RBAC.
AUTH_MODE=local

# ── Organisation (single org in v0.1) ────────────────────────────────────────
ORG_NAME=NexBridge Technologies       # displayed in the UI
ORG_SLUG=nexbridge                    # used in DB + API paths (URL-safe, lowercase)

ADMIN_EMAIL=                          # bootstrap admin (OIDC only) — remove after groups configured

# ── OIDC / Keycloak (used when AUTH_MODE=oidc) ───────────────────────────────
OIDC_ISSUER_URL=                      # REQUIRED when mode=oidc  e.g. https://keycloak.example.com/realms/myorg
OIDC_CLIENT_ID=devportal
OIDC_CLIENT_SECRET=                   # REQUIRED when mode=oidc
OIDC_REDIRECT_URL=                    # REQUIRED when mode=oidc  e.g. https://devportal.example.com/auth/callback
OIDC_ADMIN_GROUP=devportal-admins
OIDC_DEVELOPER_GROUP=devportal-developers

# ── SCM Provider ─────────────────────────────────────────────────────────────
# Selects which Git adapter the provisioner uses. No code change required —
# just set GIT_PROVIDER and fill the corresponding block below, then restart.
# "gitea"  → local or self-hosted Gitea (default, recommended for homelab)
# "gitlab" → GitLab cloud or self-hosted
GIT_PROVIDER=gitea

# Gitea — used when GIT_PROVIDER=gitea
GITEA_URL=                            # optional  e.g. https://git.docker.localhost
GITEA_TOKEN=                          # optional  Gitea PAT: Settings → Applications → Generate Token (all scopes)

# GitLab — used when GIT_PROVIDER=gitlab
GITLAB_URL=                           # optional  e.g. https://gitlab.example.com
GITLAB_TOKEN=                         # optional  GitLab PAT with scope: api

# ── Jenkins ──────────────────────────────────────────────────────────────────
JENKINS_URL=                          # optional  internal URL e.g. http://jenkins:8080
JENKINS_PUBLIC_URL=                   # optional  public URL reachable by browser + GitLab webhooks
JENKINS_USER=admin
JENKINS_TOKEN=                        # optional  Jenkins API token

# ── Harbor ───────────────────────────────────────────────────────────────────
HARBOR_URL=                           # optional  e.g. https://harbor.example.com
HARBOR_USER=admin
HARBOR_TOKEN=                         # optional  Harbor admin password or robot account secret

# ── DefectDojo ───────────────────────────────────────────────────────────────
DEFECTDOJO_URL=                       # optional  e.g. https://defectdojo.example.com
DEFECTDOJO_TOKEN=                     # optional  DefectDojo API token

# ── Dependency-Track ─────────────────────────────────────────────────────────
DEPENDENCY_TRACK_URL=                 # optional  e.g. https://dependencytrack.example.com
# API key for DevPortal → DT direct calls (project creation, CVE notifications).
# Get from: DT → Administration → Teams → create/select team → API Keys → Generate
DEPENDENCY_TRACK_API_KEY=
# Jenkins credential ID that holds the DT API key (baked into generated Jenkinsfiles)
DEPENDENCY_TRACK_API_KEY_ID=dependency-track-api-key

# ── ArgoCD ───────────────────────────────────────────────────────────────────
# Leave empty when no Kubernetes cluster is available.
# Steps 13-15 are skipped gracefully — manifests are still committed to git.
ARGOCD_URL=                           # optional  e.g. https://argocd.example.com
ARGOCD_TOKEN=                         # optional  argocd account generate-token
ARGOCD_INSECURE=false                 # set true if ArgoCD uses a self-signed cert

# ── App PostgreSQL (provisioned for developer apps, NOT devportal's own DB) ──
APP_DB_HOST=                          # optional  e.g. postgres.namespace.svc.cluster.local
APP_DB_PORT=5432
APP_DB_ADMIN_USER=postgres
APP_DB_ADMIN_PASSWORD=                # optional  postgres superuser password

# ── Credential Encryption ────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=                       # REQUIRED  32-byte AES-256-GCM key, base64-encoded

# ── HashiCorp Vault ──────────────────────────────────────────────────────────
# Leave empty when no Vault instance is available.
# Step 16 is skipped gracefully — the Vault KV path can be wired later.
VAULT_URL=                            # optional  e.g. https://vault.example.com
VAULT_TOKEN=                          # optional  Vault token with KV write + policy + auth role permissions
VAULT_KV_MOUNT=secret                 # KV v2 mount path (default: secret)
VAULT_K8S_AUTH_MOUNT=kubernetes       # Kubernetes auth method mount path
# false = use ESO ExternalSecret CR  |  true = use VSO VaultAuth + VaultStaticSecret CRs
VAULT_USE_VSO=false

# ── Jenkinsfile / K8s Manifest generation ────────────────────────────────────
# These values are baked into every generated Jenkinsfile and K8s manifest.
# Change once in .env — all future services pick up the new values.
REGISTRY_URL=                         # optional  hostname only, no https://  e.g. harbor.example.com
REGISTRY_CREDENTIALS_ID=robot-jenkins # Jenkins credential ID for Harbor push
GIT_CREDENTIALS_ID=                   # optional  Jenkins credential ID for Git clone
SHARED_LIBRARY_URL=                   # optional  Git URL of Jenkins shared pipeline library
K8S_MANIFEST_GROUP=kubernetes-manifest
INGRESS_BASE_DOMAIN=                  # optional  base domain for app ingress e.g. apps.example.com

# ── Git Bot Commit Author ─────────────────────────────────────────────────────
BOT_NAME=DevPortal Bot
BOT_EMAIL=                            # optional  e.g. devportal@example.com

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=3                  # parallel provisioning jobs

# ── TLS ──────────────────────────────────────────────────────────────────────
TLS_SKIP_VERIFY=true                  # set false once proper certs are installed

# ── Branding ─────────────────────────────────────────────────────────────────
# All optional. Change these per customer without rebuilding the image.
# Served as JSON at GET /branding.json — React applies them at boot.
#
# BRAND_PRIMARY_HUE: HSL hue (0-360). Examples:
#   199 = sky blue (default)  |  142 = green  |  262 = purple
#   221 = indigo              |  0   = red     |  38  = amber
BRAND_APP_NAME=DevPortal              # portal title shown in nav and login page
BRAND_COMPANY=                        # organisation name shown under the logo
BRAND_PRIMARY_HUE=199                 # HSL hue for the primary colour palette
BRAND_LOGO_URL=                       # optional: URL of a hosted logo image (SVG/PNG)
