# Secrets — never commit these
.env
.env.local
.env.*.local
cosign.key
cosign.pub

# Compiled binaries
bin/
*.exe
*.test
/devportal
/worker

# Go module cache artifacts
vendor/

# Frontend — node_modules never committed; dist/* is gitignored EXCEPT the
# placeholder index.html so `go build` works before `npm run build`.
web/node_modules/
web/dist/*
!web/dist/index.html

# IDE / editor state
.idea/
.vscode/
*.iml
*.swp
*.swo

# macOS
.DS_Store
